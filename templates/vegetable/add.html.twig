{% extends "client_layout/master.html.twig" %}

{% block title %}
	Ajouter un Légume
{% endblock %}

{% block content %}

	<!-- Page Header Start -->
	<div class="container-fluid page-header wow fadeIn" data-wow-delay="0.1s">
		<div class="container">
			<h1 class="display-3 mb-3 animated slideInDown">Ajouter Légume</h1>
			<nav aria-label="breadcrumb animated slideInDown">
				<ol class="breadcrumb mb-0">
					<li class="breadcrumb-item">
						<a class="text-body" href="{{ path('app_vegetable_list') }}">Légume</a>
					</li>
					<li class="breadcrumb-item text-dark active" aria-current="page">Ajouter</li>
				</ol>
			</nav>
		</div>
	</div>
	<!-- Page Header End -->
	<div class="container mt-5">
		<div class="card shadow-lg">
			<div class="card-header bg-success text-white text-center">
				<h4>
					<i class="bi bi-plus-circle"></i>
					Ajouter un légume</h4>
			</div>
			<div class="card-body">
				{{ form_start(form) }}

				<h5 class="text-primary mb-3">🌱 Informations générales</h5>
				<div class="row mb-3">
					<div class="col-md-6">
						{{ form_row(form.name) }}
					</div>
					<div class="col-md-6">
						{{ form_row(form.scientificName) }}
					</div>
				</div>
				{{ form_row(form.description) }}
				{{ form_row(form.image) }}

				<hr>

				<h5 class="text-primary mb-3">☀️ Conditions de culture</h5>
				<div class="row mb-3">
					<div class="col-md-4">{{ form_row(form.difficulty) }}</div>
					<div class="col-md-4">{{ form_row(form.soilType) }}</div>
					<div class="col-md-4">{{ form_row(form.sunlight) }}</div>
				</div>

				<div class="row mb-3">
					<div class="col-md-6">{{ form_row(form.watering) }}</div>
					<div class="col-md-3">{{ form_row(form.germinationDays) }}</div>
					<div class="col-md-3">{{ form_row(form.harvestDays) }}</div>
				</div>

				<hr>

				<h5 class="text-primary mb-3">🔗 Relations</h5>
				{{ form_row(form.category) }}
				{{ form_row(form.diseases) }}
				{{ form_row(form.seasons) }}

				<div class="text-center mt-4">
					<button class="btn btn-success w-50 rounded-pill">
						<i class="bi bi-check-circle"></i>
						Enregistrer
					</button>
				</div>

				{{ form_end(form) }}
			</div>
		</div>
	</div>

{% endblock %}
