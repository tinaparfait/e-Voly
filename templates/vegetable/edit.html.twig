{% extends "client_layout/master.html.twig" %}

{% block title %}
	Modifier un Légume
{% endblock %}

{% block content %}

	<!-- Page Header Start -->
	<div class="container-fluid page-header wow fadeIn" data-wow-delay="0.1s">
		<div class="container">
			<h1 class="display-3 mb-3 animated slideInDown">Ajouter Légume</h1>
			<nav aria-label="breadcrumb animated slideInDown">
				<ol class="breadcrumb mb-0">
					<li class="breadcrumb-item">
						<a class="text-body" href="{{ path('app_vegetable_list') }}">Légume</a>
					</li>
					<li class="breadcrumb-item text-dark active" aria-current="page">Ajouter</li>
				</ol>
			</nav>
		</div>
	</div>
	<!-- Page Header End -->
	<div class="container my-5">
		<div class="card shadow-lg border-0 rounded-4">
			<div class="card-header bg-gradient bg-success text-white text-center py-4">
				<h3 class="fw-bold mb-0">
					<i class="bi bi-pencil-square me-2"></i>
					Modifier
					{{ vegetable.name }}
				</h3>
			</div>

			<div class="card-body p-4">
				{{ form_start(form) }}

				<div class="mb-4">
					<h5 class="text-success fw-bold mb-3">🌱 Informations générales</h5>
					<div class="row g-3">
						<div class="col-md-6">
							{{ form_row(form.name) }}
						</div>
						<div class="col-md-6">
							{{ form_row(form.scientificName) }}
						</div>
					</div>
					{{ form_row(form.description) }}
					{{ form_row(form.image) }}
				</div>

				<div class="mb-4">
					<h5 class="text-success fw-bold mb-3">☀️ Conditions de culture</h5>
					<div class="row g-3">
						<div class="col-md-4">{{ form_row(form.difficulty) }}</div>
						<div class="col-md-4">{{ form_row(form.soilType) }}</div>
						<div class="col-md-4">{{ form_row(form.sunlight) }}</div>
					</div>
					<div class="row g-3 mt-3">
						<div class="col-md-6">{{ form_row(form.watering) }}</div>
						<div class="col-md-3">{{ form_row(form.germinationDays) }}</div>
						<div class="col-md-3">{{ form_row(form.harvestDays) }}</div>
					</div>
				</div>

				<div class="mb-4">
					<h5 class="text-success fw-bold mb-3">🔗 Relations</h5>
					{{ form_row(form.category) }}
					{{ form_row(form.diseases) }}
					{{ form_row(form.seasons) }}
				</div>

				<div class="text-center mt-4">
					<button class="btn btn-lg btn-success rounded-pill px-5 shadow-sm">
						<i class="bi bi-check-circle me-2"></i>
						Enregistrer les modifications
					</button>
				</div>

				{{ form_end(form) }}
			</div>
		</div>
	</div>


{% endblock %}
